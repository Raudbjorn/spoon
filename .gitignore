# Binary
/spoon
/spn

# Exports
spoon-export-*.json
# The TUI's save prompt suggests a name the user can append to, so exports land
# as spoon-export-....json.2 and similar. Match any trailing suffix.
spoon-export-*.json.*

# Local Python tooling (sidecar venv was removed; future Python experiments should be inlined)
embed/sidecar/
**/__pycache__/
*.pyc

# Experiment run artifacts (transient logs + multi-MB vector dumps; never commit)
experiments/**/*.log
experiments/**/*_vectors.json

# Isolated implementation worktrees
.worktrees/
