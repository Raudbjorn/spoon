# Maintainer: Sveinbjörn G. <claude@sveinbjorn.dev>
#
# Builds both binaries from the same source tree:
#   spoon — TUI/CSV/JSON fork-finder for human use
#   spn   — JSON-only agent CLI (PR review threads, fork enrichment NDJSON)
# Plus the using-spn agent skill into /usr/share/spoon/skills/.

pkgname=spoon-git
_pkgname=spoon
pkgver=r225.907fcfd
pkgrel=1
pkgdesc="Find useful forks of a Git repo (spoon) + agent-shaped CLI (spn)"
arch=('x86_64' 'aarch64')
url="https://github.com/Raudbjorn/spoon"
license=('custom:unknown')
depends=('glibc')
makedepends=('go>=1.26' 'git')
optdepends=(
    'github-cli: GitHub authentication for spoon/spn'
    'glab: GitLab authentication for spoon'
)
provides=("spoon=${pkgver}" "spn=${pkgver}")
conflicts=('spoon' 'spn')
source=("${_pkgname}::git+${url}.git#branch=main")
sha256sums=('SKIP')
install="${pkgname}.install"

pkgver() {
    cd "${srcdir}/${_pkgname}"
    # Prefer a tagged describe; fall back to rN.shortsha for untagged trees.
    local described
    if described="$(git describe --long --tags 2>/dev/null)"; then
        printf '%s\n' "${described}" | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf 'r%s.%s\n' \
            "$(git rev-list --count HEAD)" \
            "$(git rev-parse --short HEAD)"
    fi
}

prepare() {
    cd "${srcdir}/${_pkgname}"
    # Pre-fetch modules so the build phase doesn't need network.
    export GOPATH="${srcdir}/gopath"
    export GOFLAGS="-mod=readonly -modcacherw"
    go mod download
}

build() {
    cd "${srcdir}/${_pkgname}"

    # go-tree-sitter (the --full-mdg centrality backend) is cgo, so the
    # build needs a working C compiler; keep cgo on explicitly so a
    # CGO_ENABLED=0 in the builder's environment can't silently drop it.
    export CGO_ENABLED=1
    export CGO_CPPFLAGS="${CPPFLAGS}"
    export CGO_CFLAGS="${CFLAGS}"
    export CGO_CXXFLAGS="${CXXFLAGS}"
    export CGO_LDFLAGS="${LDFLAGS}"
    export GOPATH="${srcdir}/gopath"
    export GOFLAGS="-mod=readonly -modcacherw -trimpath -buildmode=pie"

    # Both `version` symbols are package-level `var`s (spoon 0.3.0-dev,
    # spn 0.1.0-dev), so embed the package version into each binary.
    go build \
        -ldflags="-X 'main.version=${pkgver}'" \
        -o spoon ./cmd/spoon
    go build \
        -ldflags="-X 'main.version=${pkgver}'" \
        -o spn ./cmd/spn
}

check() {
    cd "${srcdir}/${_pkgname}"
    # go test ./... compiles the cgo tree-sitter package too; force cgo on
    # for the same reason build() does — makepkg runs each phase in its own
    # subshell, so build()'s CGO_ENABLED export does not reach here.
    export CGO_ENABLED=1
    export GOPATH="${srcdir}/gopath"
    export GOFLAGS="-mod=readonly -modcacherw"
    go test ./...
}

package() {
    cd "${srcdir}/${_pkgname}"

    # Binaries.
    install -Dm755 spoon "${pkgdir}/usr/bin/spoon"
    install -Dm755 spn   "${pkgdir}/usr/bin/spn"

    # Skills — installed to /usr/share/spoon/skills/. Claude Code does NOT
    # auto-discover system locations; the .install hook prints how to
    # activate them. Skill directories ship in separate PRs; install only
    # when present so the package stays buildable on revisions that predate
    # them. Adding a new skill name to the loop is the only change needed
    # when more skills land.
    for skill in using-spn using-spn-forks; do
        if [ -f "docs/superpowers/skills/${skill}/SKILL.md" ]; then
            install -Dm644 "docs/superpowers/skills/${skill}/SKILL.md" \
                "${pkgdir}/usr/share/spoon/skills/${skill}/SKILL.md"
        fi
    done

    # Design spec + README as reference docs.
    install -Dm644 docs/superpowers/specs/2026-05-10-spn-bifurcation-design.md \
        "${pkgdir}/usr/share/doc/${pkgname}/spn-design.md"
    install -Dm644 README.md \
        "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
