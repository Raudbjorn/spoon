_post() {
    cat <<'EOF'

==> spoon and spn installed to /usr/bin

==> Authenticate before use:
      spoon auth login     (GitHub; requires SPOON_OAUTH_CLIENT_ID and
                            SPOON_OAUTH_CLIENT_SECRET in the environment;
                            see README for OAuth callback setup)
      or export GH_TOKEN / GITHUB_TOKEN
      glab auth login      (GitLab, optional)

==> spn agent skills installed to:
      /usr/share/spoon/skills/using-spn/SKILL.md         (PR review threads)
      /usr/share/spoon/skills/using-spn-forks/SKILL.md   (fork discovery + clustering)

    To enable for Claude Code (per user), symlink each into your skills dir:
      mkdir -p ~/.claude/skills
      ln -sfn /usr/share/spoon/skills/using-spn       ~/.claude/skills/using-spn
      ln -sfn /usr/share/spoon/skills/using-spn-forks ~/.claude/skills/using-spn-forks

EOF
}

post_install() { _post; }
post_upgrade() { _post; }
